# Copy this file to ".env" and edit the copy. NEVER commit ".env".
# All values below are placeholders only.

# ---------- Backend ----------
ENVIRONMENT=development
LOG_LEVEL=INFO
# Comma-separated list of frontend addresses allowed to call the API.
# Add your deployed frontend address here when you deploy.
CORS_ORIGINS=http://localhost:5173
# Folder holding the files exported from Google Colab (relative to project root).
MODEL_DIR=ml/artifacts
MODEL_FILENAME=model.joblib
SCHEMA_FILENAME=feature_schema.json
METADATA_FILENAME=model_metadata.json

# ---------- Frontend (only variables starting with VITE_ reach the browser) ----------
# Never put secrets in VITE_ variables: they are visible to anyone using the site.
VITE_API_BASE_URL=http://localhost:8000
