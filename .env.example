# Copy this file to ".env" and edit the copy. NEVER commit ".env". Placeholders only.

# ---------- Backend ----------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
# Explicit, comma-separated frontend origins. '*' is refused when ENVIRONMENT=production.
CORS_ORIGINS=http://localhost:5173

# Folder produced by the Colab notebook (relative to the project root).
MODEL_BUNDLE_DIR=ml/artifacts/pm_condition_ann_v1.0.0
REQUIRE_MODEL_AT_STARTUP=true      # true = refuse to start if the bundle is missing or invalid
ALLOW_SMOKE_TEST_BUNDLE=false      # true only to debug with a FAST_DEBUG notebook bundle (never in production)
# FORCE_DEMONSTRATION_BANNER=true  # optional: force the 'demonstration only' flag (e.g. synthetic data)

# ---------- Database ----------
# Local development (SQLite file inside backend/):
DATABASE_URL=sqlite:///predictions.db
# Hosted PostgreSQL example (placeholders; use your provider's real URL):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
AUTO_CREATE_TABLES=false           # normal path is: alembic upgrade head
STORE_INPUT_READINGS=false         # false = raw sensor values are NOT written to the database

# ---------- Limits ----------
MAX_UPLOAD_BYTES=2000000
MAX_BATCH_ROWS=5000
MAX_EXPORT_ROWS=50000

# ---------- Optional access key ----------
# If set, all endpoints except /api/health require the header X-API-Key: <value>
# API_KEY=replace-with-a-long-random-string

# ---------- Frontend (only VITE_ variables reach the browser; never put secrets here) ----------
VITE_API_BASE_URL=http://localhost:8000
