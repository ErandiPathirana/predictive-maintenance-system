              "description": "Predictions made on/after this UTC date (YYYY-MM-DD)",
              "title": "Date From"
            },
            "description": "Predictions made on/after this UTC date (YYYY-MM-DD)"
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Predictions made on/before this UTC date (inclusive)",
              "title": "Date To"
            },
            "description": "Predictions made on/before this UTC date (inclusive)"
          },
          {
            "name": "measured_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
