              "description": "e.g. Alert",
              "title": "Predicted Condition"
            },
            "description": "e.g. Alert"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "null"
