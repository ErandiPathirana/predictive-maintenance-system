  "components": {
    "schemas": {
      "BatchList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/BatchSummary"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "BatchList"
      },
      "BatchPredictionResponse": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "record_count": {
            "type": "integer",
            "title": "Record Count"
          },
          "class_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Class Counts"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          },
          "provisional_label_provenance": {
            "type": "boolean",
            "title": "Provisional Label Provenance"
          },
          "demonstration_only": {
            "type": "boolean",
            "title": "Demonstration Only"
          },
          "interpretation_note": {
            "type": "string",
            "title": "Interpretation Note",
            "default": "Predicted condition class from a statistical model. It is NOT a confirmed machine failure, and the scores are model outputs, not calibrated probabilities."
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/PredictionResult"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "batch_id",
          "filename",
          "record_count",
          "class_counts",
          "model_version",
          "provisional_label_provenance",
          "demonstration_only",
          "results"
        ],
        "title": "BatchPredictionResponse"
      },
      "BatchSummary": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "record_count": {
            "type": "integer",
            "title": "Record Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "model_version": {
            "type": "string",
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "id",
          "filename",
          "record_count",
          "created_at",
          "model_version"
        ],
        "title": "BatchSummary"
      },
