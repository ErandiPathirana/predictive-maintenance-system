{
  "openapi": "3.1.0",
  "info": {
    "title": "Motor Condition Prediction API",
    "description": "\nResearch prototype: classifies **recorded motor condition** (class labels) from sensor readings.\n\n* A prediction is a **predicted condition class, not a confirmed machine failure**.\n* Scores are model outputs, **not calibrated probabilities**.\n* Results flagged `demonstration_only` must not be used for operational decisions.\n",
    "version": "0.2.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Is the API running?",
        "operationId": "health_api_health_get",
